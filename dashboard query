const supabase = createClient();

const {
  data: { user },
} = await supabase.auth.getUser();

if (!user) {
  router.push("/auth/login");
  return;
}

const { data: documents } = await supabase
  .from("documents")
  .select("*")
  .order("created_at", {
    ascending: false,
  });

const totalFiles = documents?.length ?? 0;

const storageUsed =
  documents?.reduce(
    (total, file) => total + file.size_bytes,
    0
  ) ?? 0;

const favorites =
  documents?.filter(
    (file) => file.is_favorite
  ).length ?? 0;
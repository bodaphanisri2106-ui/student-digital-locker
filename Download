async function downloadDocument(storagePath: string) {
  const supabase = createClient();

  const { data, error } = await supabase.storage
    .from("locker")
    .createSignedUrl(storagePath, 60);

  if (error) {
    alert(error.message);
    return;
  }

  if (data?.signedUrl) {
    window.open(data.signedUrl, "_blank");
  }
}